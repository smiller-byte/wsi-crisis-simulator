# Anthropic API key — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Postgres connection string (Vercel Postgres or Supabase both work).
DATABASE_URL=

# Shared passcode staff enter (with their name) to start a practice call.
STAFF_PASSCODE=

# Separate passcode for Sarah/Hugo's supervisor view.
SUPERVISOR_PASSCODE=

# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=
